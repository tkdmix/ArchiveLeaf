          "stringUnit": {
            "state": "translated",
            "value": "Touch ID またはログインパスワードで開きます。"
          }
        }
      }
    },
    "Opens with Touch ID, or your device passcode.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID または端末のパスコードで開きます。"
          }
