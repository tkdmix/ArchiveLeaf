    "Open your shelf": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本棚を開く"
          }
        }
      }
    },
    "Opens with Face ID, or your device passcode.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID または端末のパスコードで開きます。"
          }
        }
      }
    },
    "Opens with Touch ID, or your login password.": {
      "localizations": {
