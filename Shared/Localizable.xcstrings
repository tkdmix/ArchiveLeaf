    "Opens with your device passcode.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末のパスコードで開きます。"
          }
        }
      }
    },
    "This Mac has no login password set. Set one in System Settings to lock your shelf.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac にはログインパスワードが設定されていません。本棚をロックするには、システム設定で設定してください。"
          }
        }
      }
    },
    "This device has no passcode set. Set one in Settings to lock your shelf.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末にはパスコードが設定されていません。本棚をロックするには、「設定」で設定してください。"
          }
        }
      }
    },
    "Import Bookmarks": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブックマークを取り込む"
          }
        }
      }
    },
    "Import from %@…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から取り込む…"
          }
        }
      }
    },
    "Importing bookmarks…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブックマークを取り込み中…"
          }
        }
      }
    },
    "Each app's bookmarks go into a folder of its own name, and its tags arrive beneath a tag of that name. Bookmarks already on your shelf are skipped, and notes, excerpts, and cover images are not imported.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各アプリのブックマークは、そのアプリ名のフォルダに入り、タグも同じ名前のタグの下に付きます。すでに本棚にあるブックマークは取り込まれません。メモ、抜粋、カバー画像は取り込みません。"
          }
        }
      }
    },
    "The export could not be opened: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しファイルを開けませんでした：%@"
          }
        }
      }
    },
    "Import stopped: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り込みを停止しました：%@"
          }
        }
      }
    },
    "Imported %lld bookmarks into %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@へブックマーク%1$lld件を取り込みました。"
          }
        }
      }
    },
    "Skipped %lld already on your shelf.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに本棚にある%lld件は取り込みませんでした。"
          }
        }
      }
    },
    "Skipped %lld without a usable web address.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使えるWebアドレスがない%lld件は取り込みませんでした。"
          }
        }
      }
    },
    "%lld could not be stored:": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件を保存できませんでした："
          }
        }
      }
    },
    "The export could not be read as text.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しファイルをテキストとして読み取れませんでした。"
          }
        }
      }
    },
    "The export contains no bookmarks.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しファイルにブックマークがありません。"
          }
        }
      }
    },
    "This file is not an export from that app.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは、そのアプリの書き出しファイルではありません。"
          }
        }
      }
    },
    "The export exceeds the %@ limit.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しファイルが上限の%@を超えています。"
          }
        }
      }
    },
