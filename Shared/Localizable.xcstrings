    "The backup contains a missing or unsafe file.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップに、欠落したファイルまたは安全でないファイルが含まれています。"
          }
        }
      }
    },
    "The backup manifest is too large.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップのmanifestが大きすぎます。"
          }
